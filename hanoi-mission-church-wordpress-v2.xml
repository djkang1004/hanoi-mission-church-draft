p-element-button" href="/first-visit/">처음 방문 안내</a></div><!-- /wp:button --><!-- wp:button {"className":"is-style-outline"} --><div class="wp-block-button is-style-outline"><a class="wp-block-button__link wp-element-button" href="https://maps.app.goo.gl/Uk4oDcCqqqgz59dm9">지도에서 길찾기</a></div><!-- /wp:button --></div><!-- /wp:buttons --><!-- wp:group {"style":{"border":{"style":"dashed","width":"2px"},"spacing":{"padding":{"top":"80px","bottom":"80px"}}}} --><div class="wp-block-group" style="border-style:dashed;border-width:2px;padding-top:80px;padding-bottom:80px"><!-- wp:heading {"textAlign":"center","level":3} --><h3 class="wp-block-heading has-text-align-center">대표 사진 등록 자리</h3><!-- /wp:heading --><!-- wp:paragraph {"align":"center"} --><p class="has-text-align-center">실제 예배 또는 공동체 가로 사진 · 권장 16:10 · 최소 1600px</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:heading --><h2 class="wp-block-heading">예배 시간</h2><!-- /wp:heading --><!-- wp:table --><figure class="wp-block-table"><table><tbody><tr><td>주일예배</td><td>주일 오전 10:30</td><td>2층 본당</td></tr><tr><td>수요예배·성경공부</td><td>수요일 오전 10:30</td><td>3층 예배실</td></tr><tr><td>금요기도회</td><td>금요일 오후 7:30</td><td>2층 본당</td></tr><tr><td>새벽기도회</td><td>월~금 오전 5:30</td><td>3층 예배실</td></tr></tbody></table></figure><!-- /wp:table --><!-- wp:heading --><h2 class="wp-block-heading">말씀과 주보</h2><!-- /wp:heading --><!-- wp:paragraph --><p><a href="https://www.youtube.com/@%ED%95%98%EB%85%B8%EC%9D%B4%EC%84%A0%EA%B5%90%EA%B5%90%ED%9A%8C">YouTube 최신 말씀</a>과 <a href="/archive/">교회 자료실</a>을 확인하세요.</p><!-- /wp:paragraph --><!-- wp:media-text --><div class="wp-block-media-text is-stacked-on-mobile"><figure class="wp-block-media-text__media"><img src="https://hanoimissionchurchv2.wordpress.com/wp-content/uploads/2026/10/pastor-lee-boyong-2026.jpg" alt="하노이 선교교회 담임목사 이보용 목사"/></figure><div class="wp-block-media-text__content"><!-- wp:heading {"level":3} --><h3 class="wp-block-heading">담임목사 이보용</h3><!-- /wp:heading --><!-- wp:paragraph --><p>예배와 말씀, 기도와 나눔을 통해 하노이와 열방을 품는 공동체를 세워갑니다.</p><!-- /wp:paragraph --></div></div><!-- /wp:media-text --><!-- wp:paragraph --><p>SH2-09, The Matrix One, Lê Quang Đạo, Từ Liêm, Hà Nội · +84 971 012 146 · dangian65@gmail.com</p><!-- /wp:paragraph -->]]></content:encoded><excerpt:encoded><![CDATA[]]></excerpt:encoded><wp:post_id>100</wp:post_id><wp:post_date>2026-10-18 08:00:00</wp:post_date><wp:post_date_gmt>2026-10-18 01:00:00</wp:post_date_gmt><wp:comment_status>closed</wp:comment_status><wp:ping_status>closed</wp:ping_status><wp:post_name>home</wp:post_name><wp:status>publish</wp:status><wp:post_parent>0</wp:post_parent><wp:menu_order>0</wp:menu_order><wp:post_type>page</wp:post_type><wp:post_password></wp:post_password><wp:is_sticky>0</wp:is_sticky></item><item><title><![CDATA[처음 방문]]></title><link>https://hanoimissionchurchv2.wordpress.com/first-visit/</link><pubDate>Sun, 18 Oct 2026 01:00:00 +0000</pubDate><dc:creator><![CDATA[hanoimissionchurch]]></dc:creator><guid isPermaLink="false">https://hanoimissionchurchv2.wordpress.com/?page_id=101</guid><description></description><content:encoded><![CDATA[<!-- wp:heading {"level":1} --><h1 class="wp-block-heading">처음 오셔도 괜찮습니다</h1><!-- /wp:heading --><!-- wp:paragraph --><p>출장, 주재, 유학, 이주로 하노이에 오신 분을 환영합니다.</p><!-- /wp:paragraph --><!-- wp:heading {"level":3} --><h3 class="wp-block-heading">1. 그랩에서 교회 찾기</h3><!-- /wp:heading --><!-- wp:paragraph --><p>‘Hanoi Mission Church’ 또는 ‘The Matrix One’을 검색하세요.</p><!-- /wp:paragraph --><!-- wp:heading {"level":3} --><h3 class="wp-block-heading">2. 2층 본당에서 예배</h3><!-- /wp:heading --><!-- wp:paragraph --><p>주일 오전 10:30에 오시면 안내를 받을 수 있습니다.</p><!-- /wp:paragraph --><!-- wp:heading {"level":3} --><h3 class="wp-block-heading">3. 예배 후 함께 식사</h3><!-- /wp:heading --><!-- wp:paragraph --><p>3층 공동식사에서 편하게 인사하고 교제하세요.</p><!-- /wp:paragraph --><!-- wp:group {"style":{"border":{"style":"dashed","width":"2px"},"spacing":{"padding":{"top":"60px","bottom":"60px"}}}} --><div class="wp-block-group" style="border-style:dashed;border-width:2px;padding-top:60px;padding-bottom:60px"><!-- wp:heading {"textAlign":"center","level":3} --><h3 class="wp-block-heading has-text-align-center">교회 외관·입구 사진 자리</h3><!-- /wp:heading --><!-- wp:paragraph {"align":"center"} --><p class="has-text-align-center">처음 방문자가 입구를 찾을 수 있는 사진 · 권장 4:3 · 최소 1200px</p><!-- /wp:paragraph --></div><!-- /wp:group --><!-- wp:paragraph --><p><a href="https://maps.app.goo.gl/Uk4oDcCqqqgz59dm9">Google Maps 열기</a> · 전화 <a href="tel:+84971012146">+84 971 012 146</a></p><!-- /wp:paragraph -->]]></content:encoded><excerpt:encoded><![CDATA[]]></excerpt:encoded><wp:post_id>101</wp:post_id><wp:post_date>2026-10-18 08:00:00</wp:post_date><wp:post_date_gmt>2026-10-18 01:00:00</wp:post_date_gmt><wp:comment_status>closed</wp:comment_status><wp:ping_status>closed</wp:ping_status><wp:post_name>first-visit</wp:post_name><wp:status>publish</wp:status><wp:post_parent>0</wp:post_parent><wp:menu_order>0</wp:menu_order><wp:post_type>page</wp:post_type><wp:post_password></wp:post_password><wp:is_sticky>0</wp:is_sticky></item><item><title><![CDATA[교회 소개·선교]]></title><link>https://hanoimissionchurchv2.wordpress.com/about-mission/</link><pubDate>Sun, 18 Oct 2026 01:00:00 +0000</pubDate><dc:creator><![CDATA[hanoimissionchurch]]></dc:creator><guid isPermaLink="false">https://hanoimissionchurchv2.wordpress.com/?page_id=102</guid><description></description><content:encoded><![CDATA[<!-- wp:heading {"level":1} --><h1 class="wp-block-heading">하노이에서 함께 걷는 교회</h1><!-- /wp:heading --><!-- wp:paragraph --><p>하노이 선교교회는 하나님 중심, 성경 중심, 예배 중심의 신앙을 세우며 삶의 자리와 일터에서 복음을 살아가도록 함께 기도하고 동행합니다.</p><!-- /wp:paragraph --><!-- wp:image {"sizeSlug":"large","linkDestination":"none"} --><figure class="wp-block-image size-large"><img src="https://hanoimissionchurchv2.wordpress.com/wp-content/uploads/2026/10/pastor-lee-boyong-2026.jpg" alt="담임목사 이보용 목사"/></figure><!-- /wp:image --><!-- wp:heading --><h2 class="wp-block-heading">교회 현장 사진</h2><!-- /wp:heading --><!-- wp:columns --><div class="wp-block-columns"><!-- wp:column --><div class="wp-block-column"><!-- wp:group {"style":{"border":{"style":"dashed","width":"2px"},"spacing":{"padding":{"top":"65px","bottom":"65px"}}}} --><div class="wp-block-group" style="border-style:dashed;border-width:2px;padding-top:65px;padding-bottom:65px"><!-- wp:paragraph {"align":"center"} --><p class="has-text-align-center"><strong>실제 예배 사진 자리</strong><br>4:3 · 최소 1200px</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --><!-- wp:column --><div class="wp-block-column"><!-- wp:group {"style":{"border":{"style":"dashed","width":"2px"},"spacing":{"padding":{"top":"65px","bottom":"65px"}}}} --><div class="wp-block-group" style="border-style:dashed;border-width:2px;padding-top:65px;padding-bottom:65px"><!-- wp:paragraph {"align":"center"} --><p class="has-text-align-center"><strong>식사·친교·다음세대 사진 자리</strong><br>4:3 · 최소 1200px</p><!-- /wp:paragraph --></div><!-- /wp:group --></div><!-- /wp:column --></div><!-- /wp:columns --><!-- wp:heading --><h2 class="wp-block-heading">선교후원</h2><!-- /wp:heading --><!-- wp:paragraph --><p>교회가 기도와 후원으로 함께하는 선교 사역을 소개합니다. 참여 방법과 최신 현황은 교회에 직접 문의해 주세요. 확인되지 않은 계좌정보는 게시하지 않습니다.</p><!-- /wp:paragraph -->]]></content:encoded><excerpt:encoded><![CDATA[]]></excerpt:encoded><wp:post_id>102</wp:post_id><wp:post_date>2026-10-18 08:00:00</wp:post_date><wp:post_date_gmt>2026-10-18 01:00:00</wp:post_date_gmt><wp:comment_status>closed</wp:comment_status><wp:ping_status>closed</wp:ping_status><wp:post_name>about-mission</wp:post_name><wp:status>publish</wp:status><wp:post_parent>0</wp:post_parent><wp:menu_order>0</wp:menu_order><wp:post_type>page</wp:post_type><wp:post_password></wp:post_password><wp:is_sticky>0</wp:is_sticky></item><item><title><![CDATA[자료실]]></title><link>https://hanoimissionchurchv2.wordpress.com/archive/</link><pubDate>Sun, 18 Oct 2026 01:00:00 +0000</pubDate><dc:creator><![CDATA[hanoimissionchurch]]></dc:creator><guid isPermaLink="false">https://hanoimissionchurchv2.wordpress.com/?page_id=103</guid><description></description><content:encoded><![CDATA[<!-- wp:heading {"level":1} --><h1 class="wp-block-heading">교회 자료실</h1><!-- /wp:heading --><!-- wp:paragraph --><p>주보와 교회 자료를 분류별 게시물로 관리합니다. 관리자는 각자 계정으로 로그인해 PDF와 설명을 한 번만 등록합니다.</p><!-- /wp:paragraph --><!-- wp:latest-posts {"categories":[20383784],"displayPostDate":true,"postLayout":"grid","columns":3,"postsToShow":12} /-->]]></content:encoded><excerpt:encoded><![CDATA[]]></excerpt:encoded><wp:post_id>103</wp:post_id><wp:post_date>2026-10-18 08:00:00</wp:post_date><wp:post_date_gmt>2026-10-18 01:00:00</wp:post_date_gmt><wp:comment_status>closed</wp:comment_status><wp:ping_status>closed</wp:ping_status><wp:post_name>archive</wp:post_name><wp:status>publish</wp:status><wp:post_parent>0</wp:post_parent><wp:menu_order>0</wp:menu_order><wp:post_type>page</wp:post_type><wp:post_password></wp:post_password><wp:is_sticky>0</wp:is_sticky></item><item><title><![CDATA[연락·오시는 길]]></title><link>https://hanoimissionchurchv2.wordpress.com/contact/</link><pubDate>Sun, 18 Oct 2026 01:00:00 +0000</pubDate><dc:creator><![CDATA[hanoimissionchurch]]></dc:creator><guid isPermaLink="false">https://hanoimissionchurchv2.wordpress.com/?page_id=104</guid><description></description><content:encoded><![CDATA[<!-- wp:heading {"level":1} --><h1 class="wp-block-heading">하노이에서 만나요</h1><!-- /wp:heading --><!-- wp:paragraph --><p><strong>주소</strong><br>SH2-09, The Matrix One, Lê Quang Đạo, Từ Liêm, Hà Nội</p><!-- /wp:paragraph --><!-- wp:paragraph --><p><strong>전화</strong> <a href="tel:+84971012146">+84 971 012 146</a><br><strong>이메일</strong> <a href="mailto:dangian65@gmail.com">dangian65@gmail.com</a></p><!-- /wp:paragraph --><!-- wp:buttons --><div class="wp-block-buttons"><!-- wp:button --><div class="wp-block-button"><a class="wp-block-button__link wp-element-button" href="https://maps.app.goo.gl/Uk4oDcCqqqgz59dm9">Google Maps에서 길찾기</a></div><!-- /wp:button --></div